(version 1)

;; Unknown capabilities stay denied. Explicit runtime reads let interpreters
;; and shared libraries load without granting host-wide file or IPC access.
(deny default)
(allow process-exec)
(allow process-fork)
(allow sysctl-read)
(allow file-read-metadata)
;; dyld opens the root directory while starting an executable.
(allow file-read-data (literal "/"))
(allow file-read* (subpath "/bin") (subpath "/sbin")
                  (subpath "/usr") (subpath "/System")
                  (subpath "/opt/homebrew")
                  (subpath "/Library/Frameworks/Python.framework")
                  (literal "/dev/null") (literal "/dev/urandom"))

;; Deny all network access — prevents data exfiltration
(deny network*)

;; Allow reads on the specific hook script being tested, otherwise
;; bash cannot open it and the scanner silently fails. HOOK_PATH and HOOK_DIR
;; are passed via `sandbox-exec -D` parameters.
;;
;; Why both HOOK_PATH (literal) AND HOOK_DIR (subpath)?
;; - literal HOOK_PATH: minimum needed so bash can load the hook itself.
;; - subpath HOOK_DIR: real hooks commonly `source "$(dirname "$0")/lib.sh"`
;;   or read .claude/settings.json for config. Limiting to `literal` alone
;;   would silently break any realistic multi-file hook setup.
;; This intentionally widens reads to the hook's containing directory only;
;; reads of unrelated /Users paths (credentials, shell rc files) stay denied.
(allow file-read* (literal (param "HOOK_PATH")))
(allow file-read* (subpath (param "HOOK_DIR")))

;; Hook code may run, but it must not modify the host filesystem.
(deny file-write*)
